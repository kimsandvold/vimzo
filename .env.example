# Oppslag for domenesjekken i kalkulatoren.
#
# Trengs normalt IKKE. Uten den spør nettleseren Norids RDAP-tjeneste direkte
# (rdap.norid.no), som er gratis, krever ingen nøkkel og sender CORS-hoder.
# Settes bare hvis vi en dag vil bruke en registrars API i stedet – f.eks.
# for å kunne vise pris eller bestille i samme slengen. Forventet svar er
# { "ledig": true }.
VITE_DOMENE_ENDPOINT=

# Google Analytics 4 – måle-ID-en, f.eks. G-ABC123XYZ.
#
# Lastes BARE etter at den besøkende har trykket «Godta» i samtykkebanneret
# (ekomloven krever aktivt samtykke). Er den tom, finnes det verken analyse
# eller banner, og personvernsiden sier at siden er uten informasjonskapsler.
VITE_GA_ID=

# EmailJS – sender kontaktskjemaet og oppsummeringen fra kalkulatoren.
#
# Alle tre må være satt, ellers åpner knappen en ferdig utfylt e-post i
# stedet. Finnes under Email Services, Email Templates og Account → API keys
# på emailjs.com. Den offentlige nøkkelen er laget for å ligge i nettleseren.
#
# Malen bruker disse feltene:
#   Emne:     {{emne}}
#   Innhold:  {{navn}}, {{bedrift}}, {{epost}}, {{telefon}}, {{melding}}, {{brief}}
#   Reply To: {{epost}}   ← så svaret ditt går rett til kunden
#   To Email: din egen adresse
#
# Husk å legge vimzo.no (og localhost under utvikling) inn under
# domenebegrensningen under Account → Security, så nøkkelen ikke kan brukes fra andre
# nettsteder.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase – lagrer henvendelser og gir innlogging til /admin.
#
# Fra Firebase-konsollen: Prosjektinnstillinger → Dine apper → Web-app →
# SDK-oppsett. Verdiene er offentlige av natur; det som beskytter dataene er
# firestore.rules. Uten dem lagres ingenting, og skjemaene bruker bare e-post.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Valgfri: egen mal for bekreftelse til kunden (To Email: {{epost}}, samme
# felter som over). Sendes rett etter henvendelsen. La den stå tom hvis du
# heller bruker «Auto-Reply» på hovedmalen i EmailJS – ellers får kunden to.
VITE_EMAILJS_BEKREFTELSE_ID=
