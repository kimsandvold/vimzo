# vimzo.no på et vanlig Apache-webhotell.
#
# Gjør det samme som vercel.json: rene adresser uten skråstrek til slutt,
# lang cache på filer med hash i navnet, og sikkerhetshoder. Uten denne
# filen svarer Apache på /tjenester med en omdirigering til /tjenester/ –
# og da stemmer ikke adressen med canonical-lenken på siden.

Options -Indexes -MultiViews
DirectoryIndex index.html
# Ikke legg til skråstrek på mapper – vi skriver om selv under.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Alltid HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Alltid uten www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /priser/ → /priser (men ikke forsiden).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /priser → /priser/index.html, den forhåndsrendrede filen.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>

# Ukjente adresser får forsiden, som viser «fant ikke siden» – med riktig 404-status.
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # Filer med hash i navnet (Vite: navn-AbC123xy.js) og fontene endres aldri –
  # de kan caches i et år. FilesMatch ser bare filnavnet, ikke mappen.
  <FilesMatch "(-[A-Za-z0-9_-]{8}\.(js|css)|\.woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML skal alltid sjekkes på nytt, så en ny versjon slår gjennom med én gang.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml
</IfModule>
