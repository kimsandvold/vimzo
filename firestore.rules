rules_version = '2';

// Sikkerhetsreglene for vimzo.no.
//
// Dette er det som faktisk beskytter dataene. Firebase-konfigurasjonen i
// nettleseren er offentlig; uten disse reglene kunne hvem som helst lese
// databasen.
//
// Fem samlinger:
//
//  henvendelser/{id}  Den interne saken, med notater og alt. Bare admin.
//                     Offentlige skjemaer kan OPPRETTE – aldri lese.
//
//  prosjekter/{id}    Det kunden ser på Min side: status, tidslinje, tilbud,
//                     faktura. Skrives av admin. Kunden kan lese sitt eget –
//                     koblet via bekreftet e-postadresse – og endre nøyaktig
//                     to ting: godta tilbudet, og stemple at det er skrevet
//                     en ny melding.
//
//  …/meldinger/{id}   Tråden mellom kunden og Vimzo. Begge kan skrive, ingen
//                     kan endre noe som er skrevet.
//
//  logodesign/{id}    Kundens lagrede logoer (utkast og kjøpte) på Min side.
//
//  logobestillinger/{id}  Kjøp fra logoverktøyet. Kunden oppretter sin egen
//                     (innlogget, riktig pris) og leser sine egne. Admin
//                     flytter status: levert → fakturert → betalt. Filene
//                     lastes ned med en gang, så ordren starter som levert.
//
// Legges inn med `firebase deploy --only firestore:rules`, eller i
// Firebase-konsollen under Firestore → Regler.

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogget() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function erAdmin() {
      return innlogget() && request.auth.token.email in ['kimsandvold@gmail.com', 'post@vimzo.no'];
    }

    function minEpost() {
      return request.auth.token.email.lower();
    }

    function tekst(felt, maks) {
      return request.resource.data[felt] is string && request.resource.data[felt].size() <= maks;
    }

    function gyldigAnslag() {
      let a = request.resource.data.anslag;
      return a == null || (a is map && a.keys().hasOnly(['fra', 'til']) && a.fra is number && (a.til == null || a.til is number));
    }

    // En henvendelse fra et offentlig skjema.
    function gyldigNy() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kilde', 'navn', 'bedrift', 'epost', 'telefon', 'melding', 'brief', 'pakke', 'anslag', 'logodesign', 'status', 'opprettet'])
        && d.kilde in ['kalkulator', 'kontakt']
        && d.status == 'ny'
        && d.opprettet == request.time
        && tekst('navn', 200) && d.navn.size() > 0
        && tekst('bedrift', 200)
        && tekst('epost', 254) && d.epost.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && tekst('telefon', 40)
        && tekst('melding', 5000)
        && tekst('brief', 5000)
        && tekst('pakke', 200)
        && (!('logodesign' in d) || tekst('logodesign', 100))
        && gyldigAnslag();
    }

    match /henvendelser/{id} {
      allow create: if erAdmin() || gyldigNy();
      allow read, update, delete: if erAdmin();
    }

    match /prosjekter/{id} {
      function egetProsjekt() {
        return innlogget() && resource.data.kundeEpost == minEpost();
      }

      // Det eneste kunden får endre. Hvert felt kan bare settes til
      // serverens klokkeslett – kunden kan ikke datere noe selv.
      function godtarTilbud() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tilbudGodtatt'])
          && resource.data.tilbud != null
          && resource.data.tilbudGodtatt == null
          && request.resource.data.tilbudGodtatt == request.time;
      }

      function stemplerMelding() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sistKundemelding'])
          && request.resource.data.sistKundemelding == request.time;
      }

      allow read: if erAdmin() || egetProsjekt();
      allow create, delete: if erAdmin();
      allow update: if erAdmin() || (egetProsjekt() && (godtarTilbud() || stemplerMelding()));

      match /meldinger/{melding} {
        function erKunde() {
          return innlogget()
            && get(/databases/$(database)/documents/prosjekter/$(id)).data.kundeEpost == minEpost();
        }

        function gyldigMelding(fra) {
          let d = request.resource.data;
          return d.keys().hasOnly(['fra', 'navn', 'tekst', 'tid'])
            && d.fra == fra
            && d.tid == request.time
            && d.tekst is string && d.tekst.size() > 0 && d.tekst.size() <= 5000
            && d.navn is string && d.navn.size() <= 200;
        }

        allow read: if erAdmin() || erKunde();
        allow create: if (erAdmin() && gyldigMelding('vimzo')) || (erKunde() && gyldigMelding('kunde'));
        allow delete: if erAdmin();
      }
    }

    // Bestillinger fra logoverktøyet. Kunden oppretter sin egen – med sin
    // egen uid og e-post, og prisen som hører til produktet, så ingen kan
    // bestille en logo til 1 krone. Kunden kan lese sine egne; resten er admin.
    match /logobestillinger/{id} {
      function riktigPris(d) {
        return (d.produkt == 'logo' && d.pris == 490) || (d.produkt == 'profil' && d.pris == 990);
      }

      function gyldigBestilling() {
        let d = request.resource.data;
        return innlogget()
          && d.keys().hasOnly(['uid', 'epost', 'produkt', 'pris', 'bedrift', 'orgnr', 'adresse', 'postnr', 'poststed', 'navn', 'telefon', 'merknad', 'design', 'vilkar', 'status', 'opprettet'])
          && d.uid == request.auth.uid
          && d.epost == minEpost()
          && riktigPris(d)
          && d.status == 'levert'
          && d.opprettet == request.time
          && tekst('bedrift', 200) && d.bedrift.size() > 0
          && d.orgnr is string && (d.orgnr == '' || d.orgnr.matches('^[0-9]{9}$'))
          && tekst('adresse', 200) && d.adresse.size() > 0
          && d.postnr is string && d.postnr.matches('^[0-9]{4}$')
          && tekst('poststed', 200) && d.poststed.size() > 0
          && tekst('vilkar', 500) && d.vilkar.size() > 0
          && tekst('navn', 200)
          && tekst('telefon', 40)
          && tekst('merknad', 2000)
          && tekst('design', 20000);
      }

      allow create: if gyldigBestilling();
      allow read: if erAdmin() || (innlogget() && resource.data.uid == request.auth.uid);
      allow update, delete: if erAdmin();
    }

    // Lagrede logoer på Min side. Kunden eier sine egne fullt ut – med ett
    // unntak: et design kan bare merkes som kjøpt hvis det finnes en ekte
    // bestilling på samme konto, med samme produkt. Ellers kunne hvem som helst
    // låse opp vannmerkefrie filer ved å skrive et felt selv.
    match /logodesign/{id} {
      function eier() {
        return innlogget() && resource.data.uid == request.auth.uid;
      }

      function gyldigInnhold(d) {
        return d.navn is string && d.navn.size() <= 200
          && d.design is string && d.design.size() <= 20000
          && d.forhandsvisning is string && d.forhandsvisning.size() <= 30000
          && d.oppdatert == request.time;
      }

      function ekteKjop(d) {
        let b = get(/databases/$(database)/documents/logobestillinger/$(d.bestillingId)).data;
        return b.uid == request.auth.uid && b.produkt == d.produkt;
      }

      allow create: if innlogget()
        && request.resource.data.keys().hasOnly(['uid', 'navn', 'design', 'forhandsvisning', 'bestillingId', 'produkt', 'opprettet', 'oppdatert'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestillingId == null
        && request.resource.data.produkt == null
        && request.resource.data.opprettet == request.time
        && gyldigInnhold(request.resource.data);

      allow update: if eier()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navn', 'design', 'forhandsvisning', 'bestillingId', 'produkt', 'oppdatert'])
        // Kunden kan ikke frigi selv – det feltet er admin sitt (se under).
        && request.resource.data.uid == resource.data.uid
        && gyldigInnhold(request.resource.data)
        && (
          // Uendret kjøpsstatus …
          (request.resource.data.bestillingId == resource.data.bestillingId
            && request.resource.data.produkt == resource.data.produkt)
          // … eller merket som kjøpt mot en ekte bestilling.
          || (request.resource.data.bestillingId is string && ekteKjop(request.resource.data))
        );

      allow read: if erAdmin() || eier();
      // Bare Vimzo kan frigi en logo til kunden – den faktureres da med
      // nettsiden. Admin rører ikke noe annet i designet.
      allow update: if erAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['frigitt', 'oppdatert'])
        && request.resource.data.frigitt is bool;
      // Kjøpte design blir stående – de er kvitteringen for hva som ble levert.
      allow delete: if erAdmin() || (eier() && resource.data.bestillingId == null && resource.data.get('frigitt', false) != true);
    }

    // Alt annet er stengt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
