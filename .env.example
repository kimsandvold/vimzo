# Mottak for kontaktskjemaet.
#
# Settes når det finnes et endepunkt som tar imot POST med JSON – en Firebase
# Function, en Vercel-funksjon eller tilsvarende. Er den ikke satt, faller
# skjemaet tilbake til å åpne en ferdig utfylt e-post. Det er et bevisst valg:
# en send-knapp som later som den sender noe ingen leser, er verre enn en som
# åpner e-postklienten.
VITE_KONTAKT_ENDPOINT=

# Oppslag for domenesjekken i kalkulatoren.
#
# Trengs normalt IKKE. Uten den spør nettleseren Norids RDAP-tjeneste direkte
# (rdap.norid.no), som er gratis, krever ingen nøkkel og sender CORS-hoder.
# Settes bare hvis vi en dag vil bruke en registrars API i stedet – f.eks.
# for å kunne vise pris eller bestille i samme slengen. Forventet svar er
# { "ledig": true }.
VITE_DOMENE_ENDPOINT=
